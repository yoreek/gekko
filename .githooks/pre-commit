#!/usr/bin/env sh
# Local pre-commit: tests -> build SPA -> build firmware -> add result to the commit.
# Activation (once per clone): git config core.hooksPath .githooks
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
cd "$ROOT_DIR"

echo "==> lint + native tests"
scripts/test.sh

echo "==> SPA build -> data/"
(cd portal-spa && pnpm deploy:data)

echo "==> firmware build (esp32dev)"
pio run -e esp32dev
pio run -e esp32dev -t buildfs

echo "==> collect flashable binaries into webflash/"
mkdir -p webflash
cp .pio/build/esp32dev/bootloader.bin webflash/
cp .pio/build/esp32dev/partitions.bin webflash/
cp .pio/build/esp32dev/firmware.bin webflash/
cp .pio/build/esp32dev/littlefs.bin webflash/

git add data/ webflash/bootloader.bin webflash/partitions.bin webflash/firmware.bin webflash/littlefs.bin
