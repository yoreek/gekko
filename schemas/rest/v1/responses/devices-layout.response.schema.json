{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yoreek.github.io/gekko/schemas/rest/v1/responses/devices-layout.response.schema.json",
  "title": "Display layout response",
  "type": "object",
  "properties": {
    "success": { "const": true },
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "activePageId": { "type": "string", "minLength": 1 },
    "pages": {
      "type": "array",
      "items": { "$ref": "../common/display-layout-page.schema.json" }
    }
  },
  "required": ["success", "schemaVersion", "activePageId", "pages"],
  "additionalProperties": false
}
