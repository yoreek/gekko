{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yoreek.github.io/gekko/schemas/rest/v1/responses/devices-gpio_switch.response.schema.json",
  "title": "gpio_switch device response",
  "type": "object",
  "properties": {
    "record": {
      "type": "object",
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "typeName": { "const": "gpio_switch" },
        "configRevision": { "type": "integer", "minimum": 0 }
      },
      "required": ["id", "typeName", "configRevision"],
      "additionalProperties": false
    },
    "config": { "$ref": "../devices/gpio_switch.config.schema.json" },
    "runtime": {
      "type": "object",
      "properties": {
        "status": {
          "enum": ["creating", "starting", "ready", "disabled", "faulted", "dependency_blocked", "reconfiguring", "stopping", "deleting", "unknown"]
        },
        "effectiveStatus": {
          "enum": ["creating", "starting", "ready", "disabled", "faulted", "dependency_blocked", "reconfiguring", "stopping", "deleting", "unknown"]
        },
        "output": {
          "type": "object",
          "properties": {
            "state": { "type": "boolean" },
            "physicalLevel": { "type": "boolean" }
          },
          "required": ["state", "physicalLevel"],
          "additionalProperties": false
        }
      },
      "required": ["status", "effectiveStatus", "output"],
      "additionalProperties": false
    }
  },
  "required": ["record", "config", "runtime"],
  "additionalProperties": false
}
