{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yoreek.github.io/gekko/schemas/rest/v1/responses/metrics-placeholders.response.schema.json",
  "title": "Metrics placeholders response",
  "type": "object",
  "properties": {
    "success": { "const": true },
    "registryRevision": { "type": "integer", "minimum": 0 },
    "placeholders": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "placeholder": { "type": "string", "minLength": 1 },
          "namespace": { "enum": ["dev", "system", "wifi"] },
          "sourceId": { "type": "integer", "minimum": 0 },
          "sourceLabel": { "type": "string" },
          "metricId": { "type": "integer" },
          "metricKey": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "valueType": { "enum": ["null", "bool", "int", "float", "string", "datetime", "duration"] },
          "available": { "type": "boolean" },
          "preview": { "type": "string" },
          "previewNumber": { "type": "number" }
        },
        "required": ["placeholder", "namespace", "sourceId", "metricId", "metricKey", "label", "valueType", "available", "preview"],
        "additionalProperties": false
      }
    }
  },
  "required": ["success", "registryRevision", "placeholders"],
  "additionalProperties": false
}
