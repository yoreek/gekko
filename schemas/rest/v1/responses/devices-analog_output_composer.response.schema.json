{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yoreek.github.io/gekko/schemas/rest/v1/responses/devices-analog_output_composer.response.schema.json",
  "title": "analog_output_composer device response",
  "type": "object",
  "properties": {
    "record": {
      "type": "object",
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "typeName": { "const": "analog_output_composer" },
        "configRevision": { "type": "integer", "minimum": 0 }
      },
      "required": ["id", "typeName", "configRevision"],
      "additionalProperties": false
    },
    "config": { "$ref": "../devices/analog_output_composer.config.schema.json" },
    "runtime": {
      "type": "object",
      "properties": {
        "status": {
          "enum": ["creating", "starting", "ready", "disabled", "faulted", "dependency_blocked", "reconfiguring", "stopping", "deleting", "unknown"]
        },
        "effectiveStatus": {
          "enum": ["creating", "starting", "ready", "disabled", "faulted", "dependency_blocked", "reconfiguring", "stopping", "deleting", "unknown"]
        },
        "output": {
          "type": "object",
          "properties": {
            "mode": { "enum": ["off", "manual", "scheduled"] }
          },
          "required": ["mode"],
          "additionalProperties": false
        }
      },
      "required": ["status", "effectiveStatus", "output"],
      "additionalProperties": false
    }
  },
  "required": ["record", "config", "runtime"],
  "additionalProperties": false
}
