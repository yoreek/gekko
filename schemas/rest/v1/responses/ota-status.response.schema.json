{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yoreek.github.io/gekko/schemas/rest/v1/responses/ota-status.response.schema.json",
  "title": "OTA status response",
  "type": "object",
  "properties": {
    "success": { "const": true },
    "status": { "const": "ok" },
    "enabled": { "type": "boolean" },
    "freeSketchSpace": { "type": "integer", "minimum": 0 },
    "hasError": { "type": "boolean" }
  },
  "required": ["success", "status", "enabled", "freeSketchSpace", "hasError"],
  "additionalProperties": false
}
