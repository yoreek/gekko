{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yoreek.github.io/gekko/schemas/rest/v1/responses/devices-dht11.response.schema.json",
  "title": "dht11 device response",
  "type": "object",
  "properties": {
    "record": {
      "type": "object",
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "typeName": { "const": "dht11" },
        "configRevision": { "type": "integer", "minimum": 0 }
      },
      "required": ["id", "typeName", "configRevision"],
      "additionalProperties": false
    },
    "config": { "$ref": "../devices/dht11.config.schema.json" },
    "runtime": {
      "type": "object",
      "properties": {
        "status": {
          "enum": ["creating", "starting", "ready", "disabled", "faulted", "dependency_blocked", "reconfiguring", "stopping", "deleting", "unknown"]
        },
        "effectiveStatus": {
          "enum": ["creating", "starting", "ready", "disabled", "faulted", "dependency_blocked", "reconfiguring", "stopping", "deleting", "unknown"]
        },
        "output": {
          "type": "object",
          "properties": {
            "temperature": {
              "type": "object",
              "properties": {
                "value": { "type": "number" },
                "unit": { "enum": ["celsius", "fahrenheit"] },
                "unitSymbol": { "enum": ["C", "F"] },
                "measuredAtMs": { "type": "integer", "minimum": 0 },
                "valid": { "type": "boolean" },
                "status": { "type": "string" }
              },
              "required": ["value", "unit", "unitSymbol", "measuredAtMs", "valid", "status"],
              "additionalProperties": false
            },
            "humidity": {
              "type": "object",
              "properties": {
                "value": { "type": "number" },
                "unitSymbol": { "enum": ["%"] },
                "measuredAtMs": { "type": "integer", "minimum": 0 },
                "valid": { "type": "boolean" },
                "status": { "type": "string" }
              },
              "required": ["value", "unitSymbol", "measuredAtMs", "valid", "status"],
              "additionalProperties": false
            }
          },
          "required": ["temperature", "humidity"],
          "additionalProperties": false
        }
      },
      "required": ["status", "effectiveStatus", "output"],
      "additionalProperties": false
    }
  },
  "required": ["record", "config", "runtime"],
  "additionalProperties": false
}
