{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yoreek.github.io/gekko/schemas/rest/v1/responses/devices-pcf8575_expander.response.schema.json",
  "title": "pcf8575_expander device response",
  "type": "object",
  "properties": {
    "record": {
      "type": "object",
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "typeName": { "const": "pcf8575_expander" },
        "configRevision": { "type": "integer", "minimum": 0 }
      },
      "required": ["id", "typeName", "configRevision"],
      "additionalProperties": false
    },
    "config": { "$ref": "../devices/pcf8575_expander.config.schema.json" },
    "runtime": {
      "type": "object",
      "properties": {
        "status": {
          "enum": ["creating", "starting", "ready", "disabled", "faulted", "dependency_blocked", "reconfiguring", "stopping", "deleting", "unknown"]
        },
        "effectiveStatus": {
          "enum": ["creating", "starting", "ready", "disabled", "faulted", "dependency_blocked", "reconfiguring", "stopping", "deleting", "unknown"]
        },
        "channelCount": { "type": "integer", "minimum": 0, "maximum": 16 },
        "channelStates": { "type": "integer", "minimum": 0 },
        "diagnostics": {
          "type": "object",
          "properties": {
            "status": { "enum": ["ok", "degraded"] },
            "consecutiveErrors": { "type": "integer", "minimum": 0 },
            "lastErrorCode": { "type": "integer", "minimum": 0 },
            "lastErrorAtMs": { "type": "integer", "minimum": 0 },
            "errorOps": { "type": "integer", "minimum": 0 }
          },
          "required": ["status", "consecutiveErrors", "lastErrorCode", "lastErrorAtMs", "errorOps"],
          "additionalProperties": false
        }
      },
      "required": ["status", "effectiveStatus", "channelCount", "channelStates", "diagnostics"],
      "additionalProperties": false
    }
  },
  "required": ["record", "config", "runtime"],
  "additionalProperties": false
}
