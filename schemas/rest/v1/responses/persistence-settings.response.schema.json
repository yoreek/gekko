{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yoreek.github.io/gekko/schemas/rest/v1/responses/persistence-settings.response.schema.json",
  "title": "Persistence settings response",
  "type": "object",
  "properties": {
    "success": { "const": true },
    "status": { "const": "ok" },
    "debounceMs": { "type": "integer", "minimum": 100, "maximum": 10000 },
    "maxDelayMs": { "type": "integer", "minimum": 1000, "maximum": 300000 }
  },
  "required": ["success", "status", "debounceMs", "maxDelayMs"],
  "additionalProperties": false
}
