{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yoreek.github.io/gekko/schemas/rest/v1/responses/wifi-scan.response.schema.json",
  "title": "WiFi scan response",
  "type": "object",
  "properties": {
    "success": { "const": true },
    "status": { "const": "ok" },
    "networks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ssid": { "type": "string" },
          "rssi": { "type": "integer" },
          "channel": { "type": "integer", "minimum": 0 }
        },
        "required": ["ssid", "rssi", "channel"],
        "additionalProperties": false
      }
    }
  },
  "required": ["success", "status", "networks"],
  "additionalProperties": false
}
