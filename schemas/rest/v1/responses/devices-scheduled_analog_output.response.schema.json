{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yoreek.github.io/gekko/schemas/rest/v1/responses/devices-scheduled_analog_output.response.schema.json",
  "title": "scheduled_analog_output device response",
  "type": "object",
  "properties": {
    "record": {
      "type": "object",
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "typeName": { "const": "scheduled_analog_output" },
        "configRevision": { "type": "integer", "minimum": 0 }
      },
      "required": ["id", "typeName", "configRevision"],
      "additionalProperties": false
    },
    "config": { "$ref": "../devices/scheduled_analog_output.config.schema.json" },
    "runtime": {
      "type": "object",
      "properties": {
        "status": {
          "enum": ["creating", "starting", "ready", "disabled", "faulted", "dependency_blocked", "reconfiguring", "stopping", "deleting", "unknown"]
        },
        "effectiveStatus": {
          "enum": ["creating", "starting", "ready", "disabled", "faulted", "dependency_blocked", "reconfiguring", "stopping", "deleting", "unknown"]
        },
        "output": {
          "type": "object",
          "properties": {
            "state": { "type": "integer", "minimum": 0, "maximum": 100 },
            "requestedState": { "type": "integer", "minimum": 0, "maximum": 100 },
            "mode": { "enum": ["off", "manual", "scheduled"] },
            "timeValid": { "type": "boolean" }
          },
          "required": ["state", "requestedState", "mode", "timeValid"],
          "additionalProperties": false
        }
      },
      "required": ["status", "effectiveStatus", "output"],
      "additionalProperties": false
    }
  },
  "required": ["record", "config", "runtime"],
  "additionalProperties": false
}
