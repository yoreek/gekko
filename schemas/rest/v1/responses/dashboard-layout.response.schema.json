{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yoreek.github.io/gekko/schemas/rest/v1/responses/dashboard-layout.response.schema.json",
  "title": "Dashboard layout response",
  "type": "object",
  "properties": {
    "success": { "const": true },
    "status": { "const": "ok" },
    "revision": { "type": "integer", "minimum": 0 },
    "layoutDefaulted": { "type": "boolean" },
    "layout": { "$ref": "../common/dashboard-layout.schema.json" }
