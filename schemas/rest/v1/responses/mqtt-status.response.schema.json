{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yoreek.github.io/gekko/schemas/rest/v1/responses/mqtt-status.response.schema.json",
  "title": "MQTT status response",
  "type": "object",
  "properties": {
    "success": { "const": true },
    "status": { "const": "ok" },
    "enabled": { "type": "boolean" },
    "connected": { "type": "boolean" },
    "waitingForStation": { "type": "boolean" },
    "host": { "type": "string" },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "useTls": { "type": "boolean" },
    "clientId": { "type": "string" },
    "hasCaCert": { "type": "boolean" }
  },
  "required": ["success", "status", "enabled", "connected", "waitingForStation", "host", "port", "useTls", "clientId", "hasCaCert"],
  "additionalProperties": false
}
