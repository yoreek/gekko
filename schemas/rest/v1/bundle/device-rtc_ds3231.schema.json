{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yoreek.github.io/gekko/schemas/rest/v1/bundle/device-rtc_ds3231.schema.json",
  "title": "rtc_ds3231 device-setup record",
  "type": "object",
  "properties": {
    "kind": { "const": "device" },
    "record": {
      "type": "object",
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "typeName": { "const": "rtc_ds3231" },
        "configVersion": { "type": "integer", "minimum": 1 }
      },
      "required": ["id", "typeName"],
      "additionalProperties": true
    },
    "config": { "$ref": "../devices/rtc_ds3231.config.schema.json" }
  },
  "required": ["kind", "record", "config"],
  "additionalProperties": false
}
