{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yoreek.github.io/gekko/schemas/rest/v1/requests/mqtt-ca-cert.request.schema.json",
  "title": "MQTT CA certificate upload request",
  "type": "object",
  "properties": {
    "cert": {
      "type": "string",
      "minLength": 1,
      "contentEncoding": "binary",
      "contentMediaType": "application/x-pem-file"
    }
  },
  "required": ["cert"],
  "additionalProperties": false,
  "$comment": "Multipart form-data upload field named cert containing a PEM-encoded CA certificate."
}
