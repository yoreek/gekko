{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yoreek.github.io/gekko/schemas/rest/v1/requests/devices-create-ssd1306.request.schema.json",
  "title": "Create ssd1306 request",
  "type": "object",
  "properties": {
    "typeName": { "const": "ssd1306" },
    "config": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 32 },
        "enabled": { "type": "boolean", "default": true },
        "deps": { "type": "array", "items": { "$ref": "../common/dependency.schema.json" }, "default": [] },
        "i2cAddress": { "type": "integer", "minimum": 0, "maximum": 255, "default": 60 },
        "rotation": { "type": "integer", "minimum": 0, "maximum": 3, "default": 0 },
        "panel": {
          "type": "string",
          "enum": ["128x64", "128x32", "96x16", "64x32", "custom"],
          "default": "128x64"
        },
        "width": { "type": "integer", "minimum": 1, "maximum": 255, "default": 128 },
        "height": { "type": "integer", "minimum": 1, "maximum": 255, "default": 64 },
        "layout": { "$ref": "../common/display-layout.schema.json" }
      },
      "required": ["name"],
      "additionalProperties": true
    }
  },
  "required": ["typeName", "config"],
  "additionalProperties": true
}
