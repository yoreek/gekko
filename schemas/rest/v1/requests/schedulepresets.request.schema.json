{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yoreek.github.io/gekko/schemas/rest/v1/requests/schedulepresets.request.schema.json",
  "title": "Schedule preset save request",
  "type": "object",
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 32 },
    "points": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "minuteOfDay": { "type": "integer", "minimum": 0, "maximum": 1439 },
          "state": { "type": "integer", "minimum": 0, "maximum": 100 }
        },
        "required": ["minuteOfDay", "state"],
        "additionalProperties": false
      }
    }
  },
  "required": ["name", "points"],
  "additionalProperties": false
}
