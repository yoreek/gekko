{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yoreek.github.io/gekko/schemas/rest/v1/requests/devices-create-st7735.request.schema.json",
  "title": "Create st7735 request",
  "type": "object",
  "properties": {
    "typeName": { "const": "st7735" },
    "config": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 32 },
        "enabled": { "type": "boolean", "default": true },
        "deps": { "type": "array", "items": { "$ref": "../common/dependency.schema.json" }, "default": [] },
        "spiBusDeviceId": { "type": "integer", "minimum": 1, "default": 0 },
        "chipSelectPin": { "type": "integer", "minimum": 0, "maximum": 255, "default": 5 },
        "dcPin": { "type": "integer", "minimum": 0, "maximum": 255, "default": 2 },
        "resetPin": { "type": "integer", "minimum": -1, "maximum": 255, "default": -1 },
        "rotation": { "type": "integer", "minimum": 0, "maximum": 3, "default": 0 },
        "panel": {
          "type": "string",
          "enum": ["black18", "green18", "green144", "mini096", "mini096plugin"],
          "default": "black18"
        },
        "width": { "type": "integer", "minimum": 1, "maximum": 255, "default": 128 },
        "height": { "type": "integer", "minimum": 1, "maximum": 255, "default": 160 },
        "layout": { "$ref": "../common/display-layout.schema.json" }
      },
      "required": ["name", "spiBusDeviceId"],
      "additionalProperties": true
    }
  },
  "required": ["typeName", "config"],
  "additionalProperties": true
}
