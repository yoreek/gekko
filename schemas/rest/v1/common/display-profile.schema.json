{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yoreek.github.io/gekko/schemas/rest/v1/common/display-profile.schema.json",
  "title": "display profile",
  "type": "object",
  "properties": {
    "coordinateUnit": { "type": "integer", "minimum": 0, "maximum": 2 },
    "logicalWidth": { "type": "integer", "minimum": 0, "maximum": 255 },
    "logicalHeight": { "type": "integer", "minimum": 0, "maximum": 255 },
    "supportedWidgetMask": { "type": "integer", "minimum": 0 },
    "supportedRotationsMask": { "type": "integer", "minimum": 0, "maximum": 255 },
    "maxPages": { "type": "integer", "minimum": 0, "maximum": 255 },
    "maxWidgetsPerPage": { "type": "integer", "minimum": 0, "maximum": 255 },
    "pageIdCapacity": { "type": "integer", "minimum": 0, "maximum": 255 },
    "textCapacity": { "type": "integer", "minimum": 0, "maximum": 255 },
    "maxBitmapBytes": { "type": "integer", "minimum": 0 },
    "supportsColor": { "type": "boolean" },
    "supportsBitmap": { "type": "boolean" },
    "auxSegmentMode": { "type": "integer", "minimum": 0, "maximum": 2 }
  },
  "required": [
    "coordinateUnit",
    "logicalWidth",
    "logicalHeight",
    "supportedWidgetMask",
    "supportedRotationsMask",
    "maxPages",
    "maxWidgetsPerPage",
    "pageIdCapacity",
    "textCapacity",
    "maxBitmapBytes",
    "supportsColor",
    "supportsBitmap",
    "auxSegmentMode"
  ],
  "additionalProperties": false
}
