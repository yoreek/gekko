{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yoreek.github.io/gekko/schemas/rest/v1/common/display-layout-widget.schema.json",
  "title": "Display layout widget",
  "type": "object",
  "properties": {
    "id": { "type": "string", "minLength": 1, "maxLength": 16 },
    "type": {
      "enum": ["text", "digital", "bitmap", "rect", "line", "circle", "ellipse", "character", 0, 1, 2, 3, 4, 5, 6, 7]
    },
    "bindingKind": {
      "enum": ["unbound", "device", "metric", "constant_text", 0, 1, 2, 3]
    },
    "metricNamespace": {
      "enum": ["device", "system", "wifi", 0, 1, 2]
    },
    "x": { "type": "integer", "minimum": 0, "maximum": 255 },
    "y": { "type": "integer", "minimum": 0, "maximum": 255 },
    "width": { "type": "integer", "minimum": 1, "maximum": 255 },
    "height": { "type": "integer", "minimum": 1, "maximum": 255 },
    "sourceDeviceId": { "type": "integer", "minimum": 0 },
    "metricId": { "type": "integer" },
    "refreshIntervalMs": { "type": "integer", "minimum": 0, "maximum": 60000 },
    "fontSize": { "type": "integer", "minimum": 1, "maximum": 255 },
    "strokeWidth": { "type": "integer", "minimum": 1, "maximum": 255 },
    "autoSize": { "type": "boolean", "default": false },
    "wrap": { "type": "boolean", "default": false },
    "styleFlags": { "$ref": "display-layout-widget-style-flags.schema.json" },
    "color": { "type": "string" },
    "text": { "type": "string" },
    "bitmapFormat": { "enum": ["mono1", "gray8", "rgb565", 0, 1, 2] },
    "keepAspectRatio": { "type": "boolean", "default": false },
    "bitmapData": { "type": "string" }
  },
  "required": ["id", "type", "x", "y", "width", "height"],
  "additionalProperties": false
}
