{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yoreek.github.io/gekko/schemas/rest/v1/devices/spi_bus.config.schema.json",
  "title": "spi_bus configuration",
  "type": "object",
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 32 },
    "enabled": { "type": "boolean", "default": true },
    "host": { "type": "integer", "minimum": 0, "maximum": 255, "default": 2 },
    "sckPin": { "type": "integer", "minimum": 0, "maximum": 255, "default": 18 },
    "mosiPin": { "type": "integer", "minimum": 0, "maximum": 255, "default": 23 },
    "misoPin": { "type": "integer", "minimum": -1, "maximum": 255, "default": -1 }
  },
  "required": ["name"],
  "additionalProperties": true
}
