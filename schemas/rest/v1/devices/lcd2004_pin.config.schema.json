{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yoreek.github.io/gekko/schemas/rest/v1/devices/lcd2004_pin.config.schema.json",
  "title": "lcd2004_pin configuration",
  "type": "object",
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 32 },
    "enabled": { "type": "boolean", "default": true },
    "deps": { "type": "array", "items": { "$ref": "../common/dependency.schema.json" } },
    "rsPin": { "type": "integer", "minimum": 0, "maximum": 255 },
    "ePin": { "type": "integer", "minimum": 0, "maximum": 255 },
    "d4Pin": { "type": "integer", "minimum": 0, "maximum": 255 },
    "d5Pin": { "type": "integer", "minimum": 0, "maximum": 255 },
    "d6Pin": { "type": "integer", "minimum": 0, "maximum": 255 },
    "d7Pin": { "type": "integer", "minimum": 0, "maximum": 255 },
    "backlightPin": { "type": "integer", "minimum": 0, "maximum": 255 },
    "layout": { "$ref": "../common/display-layout.schema.json" }
  },
  "required": ["name", "rsPin", "ePin", "d4Pin", "d5Pin", "d6Pin", "d7Pin"],
  "additionalProperties": true
}
