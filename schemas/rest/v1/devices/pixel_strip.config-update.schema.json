{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yoreek.github.io/gekko/schemas/rest/v1/devices/pixel_strip.config-update.schema.json",
  "title": "Partial pixel_strip configuration update",
  "type": "object",
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 32 },
    "enabled": { "type": "boolean" },
    "pin": { "type": "integer", "minimum": 0, "maximum": 255 },
    "pixelCount": { "type": "integer", "minimum": 1, "maximum": 300 },
    "restorePreviousState": { "type": "boolean" },
    "startupBrightness": { "type": "integer", "minimum": 0, "maximum": 100 }
  },
  "additionalProperties": true
}
