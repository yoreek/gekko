{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yoreek.github.io/gekko/schemas/rest/v1/devices/schedule.config-update.schema.json",
  "title": "Partial schedule configuration update",
  "type": "object",
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 32 },
    "enabled": { "type": "boolean" },
    "deps": { "type": "array", "items": { "$ref": "../common/dependency.schema.json" } },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "enabled": { "type": "boolean" },
          "weekDays": {
            "type": "array",
            "items": { "type": "integer", "minimum": 0, "maximum": 6 }
          },
          "startMinuteOfDay": { "type": "integer", "minimum": 0, "maximum": 1439 },
          "endMinuteOfDay": { "type": "integer", "minimum": 0, "maximum": 1439 },
          "mode": { "enum": ["alwaysOn", "interval"] },
          "intervalsPerWindow": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "durationMinutes": { "type": "integer", "minimum": 0, "maximum": 65535 }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
