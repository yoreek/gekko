{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yoreek.github.io/gekko/schemas/rest/v1/devices/cd74hc4067_hub.config.schema.json",
  "title": "cd74hc4067_hub configuration",
  "type": "object",
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 32 },
    "enabled": { "type": "boolean", "default": true },
    "selectPins": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "type": "integer", "minimum": 0, "maximum": 255 },
      "default": [16, 17, 18, 19]
    },
    "enablePin": { "type": "integer", "minimum": 0, "maximum": 255, "default": 255 },
    "sigPin": { "type": "integer", "minimum": 0, "maximum": 255, "default": 34 },
    "sigAttenuation": { "enum": ["0db", "2_5db", "6db", "11db"], "default": "11db" }
  },
  "required": ["name"],
  "additionalProperties": true
}
