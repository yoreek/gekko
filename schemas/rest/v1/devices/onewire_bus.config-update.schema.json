{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yoreek.github.io/gekko/schemas/rest/v1/devices/onewire_bus.config-update.schema.json",
  "title": "Partial onewire_bus configuration update",
  "type": "object",
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 32 },
    "enabled": { "type": "boolean" },
    "deps": { "type": "array", "items": { "$ref": "../common/dependency.schema.json" } },
    "gpioPin": { "type": "integer", "minimum": 0, "maximum": 255 },
    "internalPullup": { "type": "boolean" }
  },
  "additionalProperties": true
}
