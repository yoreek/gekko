{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yoreek.github.io/gekko/schemas/rest/v1/devices/lcd1602.config-update.schema.json",
  "title": "lcd1602 partial configuration update",
  "type": "object",
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 32 }, "enabled": { "type": "boolean" },
    "deps": { "type": "array", "items": { "$ref": "../common/dependency.schema.json" } },
    "i2cAddress": { "type": "integer", "minimum": 0, "maximum": 255 },
    "rsChannel": { "type": "integer", "minimum": 0, "maximum": 7 }, "eChannel": { "type": "integer", "minimum": 0, "maximum": 7 },
    "d4Channel": { "type": "integer", "minimum": 0, "maximum": 7 }, "d5Channel": { "type": "integer", "minimum": 0, "maximum": 7 },
    "d6Channel": { "type": "integer", "minimum": 0, "maximum": 7 }, "d7Channel": { "type": "integer", "minimum": 0, "maximum": 7 },
    "backlightChannel": { "type": "integer", "minimum": 0, "maximum": 7 }, "layout": { "$ref": "../common/display-layout.schema.json" }
  },
  "additionalProperties": true
}
