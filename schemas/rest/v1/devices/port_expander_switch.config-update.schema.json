{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yoreek.github.io/gekko/schemas/rest/v1/devices/port_expander_switch.config-update.schema.json",
  "title": "Partial port_expander_switch configuration update",
  "type": "object",
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 32 },
    "enabled": { "type": "boolean" },
    "restorePreviousState": { "type": "boolean" },
    "startupState": { "type": "boolean" },
    "safeState": { "type": "boolean" },
    "inverted": { "type": "boolean" },
    "channel": { "type": "integer", "minimum": 0, "maximum": 15 }
  },
  "additionalProperties": true
}
