{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yoreek.github.io/gekko/schemas/rest/v1/devices/tm1637.config-update.schema.json",
  "title": "tm1637 partial configuration update",
  "type": "object",
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 32 }, "enabled": { "type": "boolean" },
    "deps": { "type": "array", "items": { "$ref": "../common/dependency.schema.json" } },
    "panel": { "type": "string", "enum": ["four_digit_decimal_036"] },
    "brightness": { "type": "integer", "minimum": 0, "maximum": 7 }, "rotation": { "type": "integer", "enum": [0, 180] },
    "clkPin": { "type": "integer", "minimum": 0, "maximum": 255 }, "dioPin": { "type": "integer", "minimum": 0, "maximum": 255 },
    "layout": { "$ref": "../common/display-layout.schema.json" }
  },
  "additionalProperties": true
}
