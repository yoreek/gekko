{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yoreek.github.io/gekko/schemas/rest/v1/devices/pcf8574_expander.config.schema.json",
  "title": "pcf8574_expander configuration",
  "type": "object",
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 32 },
    "enabled": { "type": "boolean", "default": true },
    "deps": {
      "type": "array",
      "items": { "$ref": "../common/dependency.schema.json" },
      "default": [],
      "minItems": 1
    },
    "i2cAddress": { "type": "integer", "minimum": 0, "maximum": 127, "default": 32 },
    "inverted": { "type": "boolean", "default": false }
  },
  "required": ["name", "deps"],
  "additionalProperties": true
}
