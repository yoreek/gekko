{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yoreek.github.io/gekko/schemas/rest/v1/devices/gpio_switch.config-update.schema.json",
  "title": "Partial gpio_switch configuration update",
  "type": "object",
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 32 },
    "enabled": { "type": "boolean" },
    "deps": { "type": "array", "items": { "$ref": "../common/dependency.schema.json" } },
    "restorePreviousState": { "type": "boolean" },
    "startupState": { "type": "boolean" },
    "safeState": { "type": "boolean" },
    "inverted": { "type": "boolean" },
    "gpioPin": { "type": "integer", "minimum": 0, "maximum": 33, "not": { "minimum": 6, "maximum": 11 } }
  },
  "additionalProperties": true
}
