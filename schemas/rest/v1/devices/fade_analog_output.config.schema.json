{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yoreek.github.io/gekko/schemas/rest/v1/devices/fade_analog_output.config.schema.json",
  "title": "fade_analog_output configuration",
  "type": "object",
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 32 },
    "enabled": { "type": "boolean", "default": true },
    "deps": {
      "type": "array",
      "items": { "$ref": "../common/dependency.schema.json" },
      "default": [],
      "minItems": 1
    },
    "maxStep": { "type": "integer", "minimum": 1, "maximum": 100, "default": 41 },
    "stepIntervalMs": { "type": "integer", "minimum": 1, "maximum": 60000, "default": 200 }
  },
  "required": ["name", "deps"],
  "additionalProperties": true
}
