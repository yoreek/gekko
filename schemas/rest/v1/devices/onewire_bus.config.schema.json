{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yoreek.github.io/gekko/schemas/rest/v1/devices/onewire_bus.config.schema.json",
  "title": "onewire_bus configuration",
  "type": "object",
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 32 },
    "enabled": { "type": "boolean", "default": true },
    "deps": { "type": "array", "items": { "$ref": "../common/dependency.schema.json" }, "default": [] },
    "gpioPin": { "type": "integer", "minimum": 0, "maximum": 255, "default": 4 },
    "internalPullup": { "type": "boolean", "default": false }
  },
  "required": ["name"],
  "additionalProperties": true
}
