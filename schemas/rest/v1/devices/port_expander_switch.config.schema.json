{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yoreek.github.io/gekko/schemas/rest/v1/devices/port_expander_switch.config.schema.json",
  "title": "port_expander_switch configuration",
  "type": "object",
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 32 },
    "enabled": { "type": "boolean", "default": true },
    "deps": {
      "type": "array",
      "items": { "$ref": "../common/dependency.schema.json" },
      "default": [],
      "minItems": 1
    },
    "restorePreviousState": { "type": "boolean", "default": false },
    "startupState": { "type": "boolean", "default": false },
    "safeState": { "type": "boolean", "default": false },
    "inverted": { "type": "boolean", "default": false },
    "channel": { "type": "integer", "minimum": 0, "maximum": 15, "default": 0 }
  },
  "required": ["name"],
  "additionalProperties": true
}
