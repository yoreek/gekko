{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://yoreek.github.io/gekko/schemas/rest/v1/devices/ds18b20_temperature_sensor.config.schema.json",
  "title":"ds18b20_temperature_sensor configuration","type":"object",
  "properties":{
    "name":{"type":"string","minLength":1,"maxLength":32},"enabled":{"type":"boolean","default":true},
    "deps":{"type":"array","items":{"$ref":"../common/dependency.schema.json"}},
    "address":{"type":"string","minLength":16,"maxLength":16},"resolution":{"enum":[9,10,11,12],"default":12},
    "unit":{"enum":["celsius","fahrenheit"],"default":"celsius"},"pollMs":{"type":"integer","minimum":1000,"maximum":86400000,"default":5000},
    "reportDeltaCelsius":{"type":"number","minimum":0.01,"maximum":655.35},"reportDeltaCentiCelsius":{"type":"integer","minimum":1,"maximum":65535},
    "reportAlways":{"type":"boolean","default":false},"smoothingWeight":{"type":"number","minimum":0.000001,"maximum":1},
    "calibrationFactor":{"type":"number"},"calibrationOffset":{"type":"number"}
  },"required":["name","deps","address"],"additionalProperties":true
}
