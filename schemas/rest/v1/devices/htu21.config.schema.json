{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yoreek.github.io/gekko/schemas/rest/v1/devices/htu21.config.schema.json",
  "title": "htu21 configuration",
  "type": "object",
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 32 },
    "enabled": { "type": "boolean", "default": true },
    "deps": { "type": "array", "items": { "$ref": "../common/dependency.schema.json" }, "default": [] },
    "i2cAddress": { "type": "integer", "minimum": 0, "maximum": 127, "default": 64 },
    "unit": { "enum": ["celsius", "fahrenheit"], "default": "celsius" },
    "pollMs": { "type": "integer", "minimum": 1000, "maximum": 86400000, "default": 5000 },
    "reportAlways": { "type": "boolean", "default": false },
    "reportDeltaCelsius": { "type": "number", "minimum": 0.01, "maximum": 655.35, "default": 0.1 },
    "reportDeltaCentiCelsius": { "type": "integer", "minimum": 1, "maximum": 65535, "default": 10 },
    "reportDeltaHumidity": { "type": "number", "minimum": 0.01, "maximum": 655.35, "default": 0.1 },
    "reportDeltaCentiPercent": { "type": "integer", "minimum": 1, "maximum": 65535, "default": 10 },
    "temperatureFilter": { "$ref": "../common/sensor-filter.schema.json" },
    "humidityFilter": { "$ref": "../common/sensor-filter.schema.json" }
  },
  "required": ["name"],
  "additionalProperties": true
}
