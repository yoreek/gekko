{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yoreek.github.io/gekko/schemas/rest/v1/devices/dosing_pump.config.schema.json",
  "title": "dosing_pump configuration",
  "type": "object",
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 32 },
    "enabled": { "type": "boolean", "default": true },
    "deps": { "type": "array", "items": { "$ref": "../common/dependency.schema.json" }, "default": [] },
    "dosingSpeedMlPerSec": { "type": "number", "exclusiveMinimum": 0, "maximum": 65.535, "default": 1.0 },
    "container": {
      "type": "object",
      "properties": {
        "capacityMl": { "type": "integer", "minimum": 1, "maximum": 65535, "default": 1000 },
        "thresholdPercent": { "type": "integer", "minimum": 0, "maximum": 100, "default": 10 },
        "blockAutoWhenEmpty": { "type": "boolean", "default": true }
      },
      "additionalProperties": true
    },
    "schedule": {
      "type": "object",
      "properties": {
        "mode": { "enum": ["daily", "weekly"], "default": "daily" },
        "everyDays": { "type": "integer", "minimum": 1, "maximum": 30, "default": 1 },
        "daysOfWeek": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0, "maximum": 6 },
          "default": [0, 1, 2, 3, 4, 5, 6]
        },
        "anchorDay": { "type": "integer", "minimum": 0, "maximum": 65535, "default": 0 },
        "doses": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "time": { "type": "string", "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9]$" },
              "amountMl": { "type": "number", "exclusiveMinimum": 0, "maximum": 655.35 }
            },
            "required": ["time", "amountMl"],
            "additionalProperties": true
          },
          "default": []
        }
      },
      "additionalProperties": true
    }
  },
  "required": ["name"],
  "additionalProperties": true
}
