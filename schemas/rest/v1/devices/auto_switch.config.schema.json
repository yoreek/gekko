{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yoreek.github.io/gekko/schemas/rest/v1/devices/auto_switch.config.schema.json",
  "title": "auto_switch configuration",
  "type": "object",
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 32 },
    "enabled": { "type": "boolean", "default": true },
    "deps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": { "enum": ["switch", "condition"] },
          "deviceId": { "type": "integer", "minimum": 1 },
          "invert": { "type": "boolean", "default": false }
        },
        "required": ["role", "deviceId"],
        "additionalProperties": false
      },
      "default": []
    },
    "pauseDurationSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2592000,
      "default": 3600
    }
  },
  "required": ["name"],
  "additionalProperties": true
}
