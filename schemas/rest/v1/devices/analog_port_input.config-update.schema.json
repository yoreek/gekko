{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yoreek.github.io/gekko/schemas/rest/v1/devices/analog_port_input.config-update.schema.json",
  "title": "analog_port_input configuration update",
  "type": "object",
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 32 },
    "enabled": { "type": "boolean" },
    "gpioPin": { "type": "integer", "minimum": 0, "maximum": 48 },
    "attenuation": { "enum": ["0db", "2_5db", "6db", "11db", 0, 1, 2, 3] },
    "adcSamples": { "type": "integer", "minimum": 1, "maximum": 64 },
    "reportAlways": { "type": "boolean" },
    "reportDeltaMilliVolts": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "pollMs": { "type": "integer", "minimum": 100, "maximum": 86400000 }
  },
  "additionalProperties": true
}
