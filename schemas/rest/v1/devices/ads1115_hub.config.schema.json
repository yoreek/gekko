{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yoreek.github.io/gekko/schemas/rest/v1/devices/ads1115_hub.config.schema.json",
  "title": "ads1115_hub configuration",
  "type": "object",
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 32 },
    "enabled": { "type": "boolean", "default": true },
    "deps": { "type": "array", "items": { "$ref": "../common/dependency.schema.json" }, "default": [] },
    "i2cAddress": { "type": "integer", "minimum": 0, "maximum": 127, "default": 72 },
    "gain": { "enum": ["fsr6144", "fsr4096", "fsr2048", "fsr1024", "fsr0512", "fsr0256"], "default": "fsr2048" },
    "dataRateSps": { "enum": ["8", "16", "32", "64", "128", "250", "475", "860"], "default": "128" }
  },
  "required": ["name", "deps"],
  "additionalProperties": true
}
