{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yoreek.github.io/gekko/schemas/rest/v1/devices/dht11.config-update.schema.json",
  "title": "Partial dht11 configuration update",
  "type": "object",
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 32 },
    "enabled": { "type": "boolean" },
    "deps": { "type": "array", "items": { "$ref": "../common/dependency.schema.json" }, "maxItems": 0 },
    "gpioPin": { "type": "integer", "minimum": 0, "maximum": 39 },
    "internalPullup": { "type": "boolean" },
    "unit": { "enum": ["celsius", "fahrenheit"] },
    "pollMs": { "type": "integer", "minimum": 1000, "maximum": 86400000 },
    "reportAlways": { "type": "boolean" },
    "reportDeltaCelsius": { "type": "number", "minimum": 0.01, "maximum": 655.35 },
    "reportDeltaCentiCelsius": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "reportDeltaHumidity": { "type": "number", "minimum": 0.01, "maximum": 655.35 },
    "reportDeltaCentiPercent": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "temperatureFilter": { "$ref": "../common/sensor-filter.schema.json" },
    "humidityFilter": { "$ref": "../common/sensor-filter.schema.json" }
  },
  "additionalProperties": true
}
