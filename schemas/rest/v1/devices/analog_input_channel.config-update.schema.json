{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yoreek.github.io/gekko/schemas/rest/v1/devices/analog_input_channel.config-update.schema.json",
  "title": "analog_input_channel configuration update",
  "type": "object",
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 32 },
    "enabled": { "type": "boolean" },
    "channel": { "type": "integer", "minimum": 0, "maximum": 15 },
    "adcSamples": { "type": "integer", "minimum": 1, "maximum": 32 },
    "reportAlways": { "type": "boolean" },
    "reportDeltaMilliVolts": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "pollMs": { "type": "integer", "minimum": 100, "maximum": 86400000 }
  },
  "additionalProperties": true
}
