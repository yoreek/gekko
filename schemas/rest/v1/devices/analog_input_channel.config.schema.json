{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yoreek.github.io/gekko/schemas/rest/v1/devices/analog_input_channel.config.schema.json",
  "title": "analog_input_channel configuration",
  "type": "object",
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 32 },
    "enabled": { "type": "boolean", "default": true },
    "deps": { "type": "array", "items": { "$ref": "../common/dependency.schema.json" }, "default": [] },
    "channel": { "type": "integer", "minimum": 0, "maximum": 15, "default": 0 },
    "adcSamples": { "type": "integer", "minimum": 1, "maximum": 32, "default": 4 },
    "reportAlways": { "type": "boolean", "default": false },
    "reportDeltaMilliVolts": { "type": "integer", "minimum": 1, "maximum": 65535, "default": 10 },
    "pollMs": { "type": "integer", "minimum": 100, "maximum": 86400000, "default": 1000 }
  },
  "required": ["name", "channel"],
  "additionalProperties": true
}
