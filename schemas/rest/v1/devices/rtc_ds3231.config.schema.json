{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yoreek.github.io/gekko/schemas/rest/v1/devices/rtc_ds3231.config.schema.json",
  "title": "rtc_ds3231 configuration",
  "type": "object",
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 32 },
    "enabled": { "type": "boolean", "default": true },
    "deps": { "type": "array", "items": { "$ref": "../common/dependency.schema.json" }, "default": [] },
    "i2cAddress": { "type": "integer", "minimum": 0, "maximum": 127, "default": 104 },
    "useForSystemTimeSync": { "type": "boolean", "default": false }
  },
  "required": ["name"],
  "additionalProperties": true
}
