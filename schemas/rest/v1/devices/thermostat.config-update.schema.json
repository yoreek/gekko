{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yoreek.github.io/gekko/schemas/rest/v1/devices/thermostat.config-update.schema.json",
  "title": "thermostat configuration update",
  "type": "object",
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 32 },
    "enabled": { "type": "boolean" },
    "mode": { "enum": ["off", "cool", "heat"] },
    "algorithm": { "enum": ["hysteresis"] },
    "targetCelsius": { "type": "number", "minimum": -327.68, "maximum": 327.67 },
    "targetMilliCelsius": { "type": "integer", "minimum": -327680, "maximum": 327670 },
    "minSafeCelsius": { "type": "number", "minimum": -327.68, "maximum": 327.67 },
    "minSafeMilliCelsius": { "type": "integer", "minimum": -327680, "maximum": 327670 },
    "maxSafeCelsius": { "type": "number", "minimum": -327.68, "maximum": 327.67 },
    "maxSafeMilliCelsius": { "type": "integer", "minimum": -327680, "maximum": 327670 },
    "hysteresisCelsius": { "type": "number", "minimum": 0.01, "maximum": 100.0 },
    "hysteresisCentiCelsius": { "type": "integer", "minimum": 1, "maximum": 10000 },
    "checkIntervalMs": { "type": "integer", "minimum": 100, "maximum": 86400000 },
    "sensorTimeoutMs": { "type": "integer", "minimum": 100, "maximum": 86400000 },
    "retryAfterErrorMs": { "type": "integer", "minimum": 100, "maximum": 86400000 },
    "minSwitchIntervalMs": { "type": "integer", "minimum": 0, "maximum": 86400000 }
  },
  "additionalProperties": true
}
