{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yoreek.github.io/gekko/schemas/rest/v1/devices/scheduled_analog_output.config-update.schema.json",
  "title": "Partial scheduled_analog_output configuration update",
  "type": "object",
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 32 },
    "enabled": { "type": "boolean" },
    "deps": {
      "type": "array",
      "items": { "$ref": "../common/dependency.schema.json" }
    },
    "points": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "deleted": { "type": "boolean" },
          "minuteOfDay": { "type": "integer", "minimum": 0, "maximum": 1439 },
          "state": { "type": "integer", "minimum": 0, "maximum": 100 }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
