{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yoreek.github.io/gekko/schemas/rest/v1/devices/gpio_switch.config.schema.json",
  "title": "gpio_switch configuration",
  "type": "object",
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 32 },
    "enabled": { "type": "boolean", "default": true },
    "deps": { "type": "array", "items": { "$ref": "../common/dependency.schema.json" }, "default": [] },
    "restorePreviousState": { "type": "boolean", "default": false },
    "startupState": { "type": "boolean", "default": false },
    "safeState": { "type": "boolean", "default": false },
    "inverted": { "type": "boolean", "default": false },
    "gpioPin": {
      "type": "integer",
      "minimum": 0,
      "maximum": 33,
      "not": { "minimum": 6, "maximum": 11 },
      "default": 2,
      "description": "ESP32 output GPIO; flash pins 6 through 11 are invalid."
    }
  },
  "required": ["name"],
  "additionalProperties": true
}
