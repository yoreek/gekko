{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yoreek.github.io/gekko/schemas/rest/v1/devices/schedule.config.schema.json",
  "title": "schedule configuration",
  "type": "object",
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 32 },
    "enabled": { "type": "boolean", "default": true },
    "deps": { "type": "array", "items": { "$ref": "../common/dependency.schema.json" }, "default": [] },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "enabled": { "type": "boolean", "default": true },
          "weekDays": {
            "type": "array",
            "items": { "type": "integer", "minimum": 0, "maximum": 6 },
            "default": [0, 1, 2, 3, 4, 5, 6]
          },
          "startMinuteOfDay": { "type": "integer", "minimum": 0, "maximum": 1439, "default": 0 },
          "endMinuteOfDay": { "type": "integer", "minimum": 0, "maximum": 1439, "default": 1439 },
          "mode": { "enum": ["alwaysOn", "interval"], "default": "alwaysOn" },
          "intervalsPerWindow": { "type": "integer", "minimum": 1, "maximum": 65535, "default": 1 },
          "durationMinutes": { "type": "integer", "minimum": 0, "maximum": 65535, "default": 1 }
        },
        "required": [],
        "additionalProperties": true
      },
      "default": []
    }
  },
  "required": ["name"],
  "additionalProperties": true
}
